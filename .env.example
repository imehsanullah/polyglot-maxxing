# Set an absolute path if you want the data outside this repository.
POLYGLOT_MAXXING_DATA_DIR=./data

# Translate subtitle batches through the attached ChatGPT/Codex account with
# GPT-5.6 Luna.
POLYGLOT_MAXXING_CODEX_TRANSLATION_MODEL=gpt-5.6-luna
POLYGLOT_MAXXING_CODEX_TRANSLATION_EFFORT=low
POLYGLOT_MAXXING_CODEX_TRANSLATION_TIMEOUT_SECONDS=90

# ChatGPT authentication and contextual word explanations through the Codex
# SDK. Authentication is stored below POLYGLOT_MAXXING_DATA_DIR and is never
# bundled with the extension.
POLYGLOT_MAXXING_CODEX_CONCURRENCY=2
POLYGLOT_MAXXING_CODEX_TIMEOUT_SECONDS=90
